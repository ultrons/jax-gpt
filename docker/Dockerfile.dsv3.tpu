# DeepSeek-V3 trainer on TPU.
#
# Build:
#   sudo docker build -f docker/Dockerfile.dsv3.tpu \
#     -t gcr.io/tpu-vm-gke-testing/jax-gpt-dsv3:<tag> .
# Push:
#   sudo docker push gcr.io/tpu-vm-gke-testing/jax-gpt-dsv3:<tag>
#
# Run inside the container (matches what k8s/dsv3/*.yaml does):
#   python -m jax_gpt.models.dsv3.train --config=full ...

FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# JAX with TPU support + profiling + GCS cache deps.
# jax 0.10.0 + libtpu 0.0.41.dev20260417: fixes host DMA inside lax.scan
# (device_put to pinned_host for offloaded gradient checkpoints).
RUN pip install --upgrade pip && \
    pip install \
        "jax==0.10.0" "jaxlib==0.10.0" \
        -f https://storage.googleapis.com/jax-releases/libtpu_releases.html && \
    pip install \
        "https://storage.googleapis.com/libtpu-nightly-releases/wheels/libtpu/libtpu-0.0.41.dev20260417+nightly-cp312-cp312-manylinux_2_31_x86_64.whl" && \
    pip install \
        "etils[epath]" \
        tensorboard-plugin-profile \
        tensorflow \
        gcsfs

# Weight loading + eval deps.
RUN pip install transformers safetensors sentencepiece datasets -q
# orbax for MaxText DSv3 checkpoint reading (eval_maxtext_lm_loss.py).
RUN pip install "orbax-checkpoint" -q

# ── Copy the source tree ──────────────────────────────────────────────────
# Post-restructure (commits 4290b00, 3c0870b, 49d6949), the dsv3 model lives
# at jax_gpt/models/dsv3/ with kernels in jax_gpt/models/dsv3/kernels/
# (including fused_moe_bwd/). We copy the full package so relative imports
# (`from .model import ...`) and `python -m jax_gpt.models.dsv3.train` work.
COPY jax_gpt /app/jax_gpt

# Vendored fused_ep_moe forward kernel (from external tpu-inference repo).
# Lives at dsv3/tpu_inference/ on disk (gitignored — present locally as a
# reference vendor copy). The dsv3/kernels/fused_moe_bwd/ tests import it
# via `from tpu_inference.kernels...` so we expose it on PYTHONPATH.
COPY dsv3/tpu_inference /app/tpu_inference

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

# Entrypoint = the dsv3 trainer. k8s YAMLs override with the same command
# (or with custom args) — see k8s/dsv3/dsv3-train-*.yaml.
ENTRYPOINT ["python", "-m", "jax_gpt.models.dsv3.train"]
