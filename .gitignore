# Environments
.env
.venv
venv/
ENV/
env/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Vim swap files
*.swp
*.swo

# Build artifacts
build/
dist/
*.egg-info/

# Log files
*.log

# autoperf-pulled profiles (large xplanes, gs:// mirror is canonical; AGENT.md §7)
autoperf/profiles/

# macOS / Windows
.DS_Store
Thumbs.db

# Per-user AI assistant / agent settings — never tracked.
.claude/
.aider*
.cursor/
.continue/
.copilot/
.github-copilot/
.codeium/

# Editor / IDE
.vscode/
.idea/
.project
.pydevproject
.settings/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# HF datasets / model caches (often huge, never commit)
hf_datasets_cache/
.cache/

# Vendored / external project trees kept on disk for reference but not tracked.
dsv3/tpu_inference/

# Secrets
*.pem
*.key
credentials*
service-account*.json
.pypirc

# Local junk
*.tmp
*.bak
*.orig
.python-version

# Reference materials (PDFs, screenshots, slide decks) — keep on disk as
# untracked references but DON'T let them poison the cde tag hash. cde
# computes the image tag from the working tree state; any drop-in PDF
# (e.g. DSv4 paper, screenshots) would otherwise force a rebuild.
*.pdf
*.png
*.pptx
